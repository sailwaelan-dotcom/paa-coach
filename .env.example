# Configuration paa-coach
# Copiez ce fichier vers .env et complétez avec vos valeurs. Ne versionnez jamais .env.

# Modèle Vertex AI
# Référence : https://cloud.google.com/vertex-ai/generative-ai/docs/learn/models
PAA_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=mon-projet-gcp
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Sécurité Model Armor (optionnel en local, recommandé en production)
# Chemins complets des templates dans la même région que GOOGLE_CLOUD_LOCATION
PAA_MODEL_ARMOR_PROMPT_TEMPLATE=projects/mon-projet-gcp/locations/europe-west1/templates/paa-prompt-filter
PAA_MODEL_ARMOR_RESPONSE_TEMPLATE=projects/mon-projet-gcp/locations/europe-west1/templates/paa-response-filter

# Clé API Google Developer Knowledge (optionnelle si ADC ou compte de service Cloud Run actif)
# DEVELOPER_KNOWLEDGE_API_KEY=AIzaSy...

# Contrôle d'accès IAP (Cloud Run)
PAA_ALLOWED_MEMBER=user:utilisateur@example.com

# Alerte budget Cloud (en EUR)
PAA_BUDGET_EUR=20

# Dossier des questions et de l'index de référence (optionnel, défaut auto)
# PAA_REFERENCE_DIR=reference
